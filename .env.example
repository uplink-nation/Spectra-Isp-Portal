# ==============================================================================
# SPECTRA FIBER BROADBAND PORTAL - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION (Required on Vercel & Local)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 2. NOC ADMINISTRATOR ACCESS & ROLE-BASED ACCESS CONTROL
# ------------------------------------------------------------------------------
ADMIN_EMAILS=admin@spectra.co,noc@spectra.co

# ------------------------------------------------------------------------------
# 3. TELEGRAM BOT NOTIFICATIONS & WHATSAPP NOC ESCALATIONS (Optional on Vercel)
# ------------------------------------------------------------------------------
# Bot Token for sending high-priority ticket dispatches directly into NOC group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1003972724689

# NOC WhatsApp Phone for instant 1-click speedtest benchmark diagnostics
NEXT_PUBLIC_NOC_WHATSAPP_PHONE=918040405050

# ------------------------------------------------------------------------------
# 4. TELEGRAM BACKGROUND MTPROTO WORKER (Required on Worker Machine / VPS / PM2)
# ------------------------------------------------------------------------------
# Telegram API Credentials obtained from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_STATUS_CHAT_ID=-627642374
